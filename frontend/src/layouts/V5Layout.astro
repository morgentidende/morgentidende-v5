---
import '../styles/v5.css';
import NewsletterSignup from '../components/NewsletterSignup.astro';
const { title='Morgentidende', description='Morgentidende – Danmarks nye avis', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://morgentidende.dk').toString();
---
<!doctype html>
<html lang="da" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {image ? <meta property="og:image" content={image} /> : null}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <title>{title}</title>
  <script is:inline src="/v5-theme.js"></script>
</head>
<body>
<header class="v5-masthead">
  <div class="v5-masthead__top v5-shell">
    <a class="v5-brand" href="/" aria-label="Morgentidende forside">
      <img src="/morgentidende-v5-sun.svg" width="54" height="54" alt="" />
      <span class="v5-brand__text"><strong>Morgentidende</strong><small>Danmarks nye avis</small></span>
    </a>
    <div class="v5-actions">
      <a class="v5-icon-button" href="/soeg" aria-label="Søg" title="Søg">⌕</a>
      <button class="v5-theme-button" type="button" data-theme-toggle>Mørk</button>
    </div>
  </div>
  <nav class="v5-nav" aria-label="Hovednavigation">
    <div class="v5-shell v5-nav__inner">
      <a href="/kategori/indland">Indland</a><a href="/kategori/udland">Udland</a><a href="/kategori/penge">Penge</a><a href="/kategori/kultur">Kultur</a><a href="/kategori/tema">Tema</a><a href="/kategori/viden">Viden</a><a href="/kategori/liv">Liv</a>
    </div>
  </nav>
</header>
<main><slot /></main>
<footer class="v5-footer">
  <div class="v5-shell"><NewsletterSignup />
    <div class="v5-footer__links"><a href="/om-morgentidende">Om Morgentidende</a><a href="/redaktionelle-principper">Redaktionelle principper</a><a href="/kontakt">Kontakt</a><a href="/privatliv">Privatliv</a></div>
    <p class="v5-footer__legal">© Alt materiale på denne side er omfattet af gældende lov om ophavsret.</p>
  </div>
</footer>
</body>
</html>
