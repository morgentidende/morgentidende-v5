---
import type { Article, SpecialSection } from '../lib/types';
import V5Card from './V5Card.astro';

const { section, articles, leadPackage = false } = Astro.props as {
  section: SpecialSection;
  articles: Article[];
  leadPackage?: boolean;
};

const destination = section.slot === 1 ? 'special_1' : 'special_2';
const items = articles.filter((a) => a.frontpage_destination === destination).slice(0, 10);
const lead = items[0] ?? null;
const followups = items.slice(1, 4);
const carouselId = `v5-special-carousel-${section.slot}`;
---
{items.length ? (
  leadPackage ? (
    <section class="v5-theme-package">
      <div class="v5-theme-package__labels">
        <span class="v5-theme-package__kind">Tema</span>
        <span class="v5-theme-package__title">{section.title}</span>
      </div>

      {lead ? <div class="v5-theme-package__lead"><V5Card article={lead} deck={true} /></div> : null}

      {followups.length ? <div class="v5-theme-package__followups">
        {followups.map((article) => (
          <article class="v5-theme-followup">
            <a class="v5-theme-followup__image-link" href={`/artikel/${article.slug}`} aria-label={article.headline}>
              <img class="v5-theme-followup__image" src={article.hero_url} alt={article.hero_alt || ''} loading="lazy" />
            </a>
            <h3 class="v5-theme-followup__headline"><a href={`/artikel/${article.slug}`}>{article.headline}</a></h3>
          </article>
        ))}
      </div> : null}
    </section>
  ) : (
    <section class="v5-section v5-special-carousel-section">
      <div class="v5-special-carousel__header">
        <div>
          <div class="v5-kicker">SPECIALSEKTION</div>
          <h2 class="v5-section-title v5-special-carousel__title">
            <span>{section.title}</span><span class="v5-special-carousel__title-arrow" aria-hidden="true">→</span>
          </h2>
        </div>
        {items.length > 4 ? (
          <button class="v5-special-carousel__next" type="button" data-carousel-next={carouselId} aria-label={`Se flere artikler i ${section.title}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.5 15 12l-6.5 6.5"/></svg>
          </button>
        ) : null}
      </div>

      <div class="v5-special-carousel__viewport" id={carouselId} data-special-carousel>
        <div class="v5-special-carousel__track">
          {items.map((article) => <V5Card article={article} />)}
        </div>
      </div>
    </section>
  )
) : null}

<script>
  const buttons = document.querySelectorAll('[data-carousel-next]');
  buttons.forEach((button) => {
    if (!(button instanceof HTMLButtonElement) || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    const id = button.dataset.carouselNext;
    const viewport = id ? document.getElementById(id) : null;
    if (!(viewport instanceof HTMLElement)) return;

    const update = () => {
      const atEnd = viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 3;
      button.classList.toggle('is-at-end', atEnd);
      button.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
    };

    button.addEventListener('click', () => {
      if (button.getAttribute('aria-disabled') === 'true') return;
      viewport.scrollBy({ left: viewport.clientWidth * 0.72, behavior: 'smooth' });
    });
    viewport.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
