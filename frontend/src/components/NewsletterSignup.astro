<section class="v5-newsletter" aria-labelledby="v5-newsletter-title">
  <div>
    <div class="v5-kicker">NYHEDSBREV</div>
    <h2 id="v5-newsletter-title">Morgentidende direkte i indbakken</h2>
    <p>Dagens vigtigste historier. Kort, klart og med plads til begge sider.</p>
  </div>
  <form class="v5-newsletter__form" data-newsletter-form>
    <label class="sr-only" for="newsletter-email">E-mail</label>
    <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="din@email.dk" required />
    <button type="submit">Tilmeld</button>
    <p class="v5-newsletter__status" data-newsletter-status aria-live="polite"></p>
  </form>
</section>
<script>
  document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const el = event.currentTarget as HTMLFormElement;
      const status = el.querySelector('[data-newsletter-status]') as HTMLElement;
      const email = (new FormData(el).get('email') || '').toString();
      status.textContent = 'Sender…';
      try {
        const base = 'https://wmyoplpweamkflbtvqid.supabase.co';
        const response = await fetch(`${base}/functions/v1/v5-newsletter-subscribe`, {
          method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'subscribe', email })
        });
        const body = await response.json();
        if (!response.ok) throw new Error(body?.error || 'Kunne ikke tilmelde');
        status.textContent = 'Tjek din indbakke for bekræftelse.';
        el.reset();
      } catch { status.textContent = 'Tilmelding mislykkedes. Prøv igen.'; }
    });
  });
</script>
